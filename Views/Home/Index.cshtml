@model PeliculaLanding.Models.MovieViewModel

@{
    ViewData["Title"] = Model.Titulo;
}

<style>
    .hero-banner {
        position: relative;
        background: linear-gradient(180deg, rgba(13, 12, 29, 0.5) 0%, rgba(13, 12, 29, 0.95) 100%), 
                    url('@Model.HeroBannerURL') center/cover no-repeat;
        border-radius: 16px;
        padding: 50px 30px;
        border: 1px solid rgba(255, 107, 53, 0.3);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
    }

    .sunset-title {
        font-weight: 900;
        text-transform: uppercase;
        background: linear-gradient(45deg, #ff6b35, #f77f00, #d62828);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0 0 20px rgba(255, 107, 53, 0.3);
    }

    .card-sunset {
        background-color: #151421;
        border: 1px solid #2d2a3e;
        border-radius: 12px;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .card-sunset:hover {
        transform: translateY(-4px);
        border-color: #ff6b35;
    }

    .timer-card {
        background: #1d1b2a;
        border: 1px solid #ff6b35;
        border-radius: 10px;
        padding: 12px;
        min-width: 75px;
    }
</style>


<div class="hero-banner my-3">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="badge bg-danger text-uppercase px-3 py-2 mb-3 rounded-pill">Estreno Próximamente</span>
            <h1 class="display-3 sunset-title mb-2">@Model.Titulo</h1>
            <p class="fs-5 text-warning mb-4 fw-semibold">@Model.TagLine</p>
            <div class="d-flex flex-wrap gap-3">
                <button type="button" class="btn btn-primary btn-lg px-4" data-bs-toggle="modal" data-bs-target="#trailerModal">
                    ▶ Ver Tráiler
                </button>
                <a href="#detalles" class="btn btn-outline-warning btn-lg px-4">
                    Ver Detalles
                </a>
            </div>
        </div>

        <div class="col-lg-5 text-center">
            <img src="@Model.PosterURL" alt="Poster @Model.Titulo" class="img-fluid rounded-4 shadow-lg border border-warning" style="max-height: 420px; object-fit: cover;" />
        </div>
    </div>
</div>


<section id="detalles" class="py-4">
    <div class="row g-4 align-items-stretch">
        
        <div class="col-md-7">
            <div class="card-sunset p-4 h-100">
                <h3 class="text-warning fw-bold mb-3">Sinopsis</h3>
                <p class="text-light leading-relaxed fs-6">@Model.Sipnosis</p>
                <hr class="border-secondary my-3" />
                <div class="row text-secondary small">
                    <div class="col-6">🎬 <strong>Director:</strong> <span class="text-white">@Model.Director</span></div>
                    <div class="col-6">🏢 <strong>Estudios:</strong> <span class="text-white">@Model.Estudio</span></div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card-sunset p-4 h-100 text-center d-flex flex-column justify-content-center">
                <h4 class="text-white fw-bold mb-3">⏱️ Cuenta Regresiva</h4>
                <div class="d-flex justify-content-center gap-2 my-2">
                    <div class="timer-card">
                        <span id="cd-days" class="fs-2 fw-bold text-warning">--</span>
                        <div class="small text-secondary">Días</div>
                    </div>
                    <div class="timer-card">
                        <span id="cd-hours" class="fs-2 fw-bold text-danger">--</span>
                        <div class="small text-secondary">Horas</div>
                    </div>
                    <div class="timer-card">
                        <span id="cd-minutes" class="fs-2 fw-bold text-warning">--</span>
                        <div class="small text-secondary">Mins</div>
                    </div>
                    <div class="timer-card">
                        <span id="cd-seconds" class="fs-2 fw-bold text-danger">--</span>
                        <div class="small text-secondary">Segs</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>


<section class="py-3">
    <h3 class="text-white fw-bold mb-4">Elenco Principal</h3>
    <div class="row g-3">
        @if (Model.Reparto != null)
        {
            @foreach (var actor in Model.Reparto)
            {
                <div class="col-md-4">
                    <div class="card-sunset p-3 text-center">
                        <div class="fs-2 mb-1">@actor.Icono</div>
                        <h5 class="text-white fw-bold mb-0">@actor.Nombre</h5>
                        <small class="text-warning">@actor.Personaje</small>
                    </div>
                </div>
            }
        }
    </div>
</section>

<div class="modal fade" id="trailerModal" tabindex="-1" aria-labelledby="trailerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark text-white border-warning">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold text-warning" id="trailerModalLabel">@Model.Titulo - Tráiler</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <div class="ratio ratio-16x9">
                    <iframe id="youtubeIframe" src="https://www.youtube.com/embed/@Model.TrailerID" title="YouTube Trailer" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const targetDate = new Date("@Model.Lanzamiento").getTime();

            function updateTimer() {
                const now = new Date().getTime();
                const diff = targetDate - now;

                if (diff > 0) {
                    document.getElementById("cd-days").innerText = Math.floor(diff / (1000 * 60 * 60 * 24));
                    document.getElementById("cd-hours").innerText = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    document.getElementById("cd-minutes").innerText = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                    document.getElementById("cd-seconds").innerText = Math.floor((diff % (1000 * 60)) / 1000);
                }
            }

            setInterval(updateTimer, 1000);
            updateTimer();

            const modal = document.getElementById('trailerModal');
            if (modal) {
                modal.addEventListener('hidden.bs.modal', function () {
                    const iframe = document.getElementById('youtubeIframe');
                    if (iframe) {
                        iframe.src = iframe.src;
                    }
                });
            }
        });
    </script>
}